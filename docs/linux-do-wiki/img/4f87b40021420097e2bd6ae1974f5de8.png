set-x-0 top-0 -z-10 h-[64rem] w-full stroke-gray-200 [mask-image:radial-gradient(32rem_32rem_at_center,white,transparent)]" aria-hidden="true"><defs><pattern id="1f932ae7-37de-4c0a-a8b0-a6e3b4d44b84" width="200" height="200" x="50%" y="-1" patternUnits="userSpaceOnUse"><path d="M.5 200V.5H200" fill="none"></path></pattern></defs><svg x="50%" y="-1" class="overflow-visible fill-gray-50"><path d="M-200 0h201v201h-201Z M600 0h201v201h-201Z M-400 600h201v201h-201Z M200 800h201v201h-201Z" stroke-width="0"></path></svg><rect width="100%" height="100%" stroke-width="0" fill="url(#1f932ae7-37de-4c0a-a8b0-a6e3b4d44b84)"></rect></svg><div class="absolute left-1/2 right-0 top-0 -z-10 -ml-24 transform-gpu overflow-hidden blur-3xl lg:ml-24 xl:ml-48" aria-hidden="true"><div class="aspect-[801/1036] w-[50.0625rem] bg-gradient-to-tr from-[#ff80b5] to-[#9089fc] opacity-30" style="clip-path:polygon(63.1% 29.5%, 100% 17.1%, 76.6% 3%, 48.4% 0%, 44.6% 4.7%, 54.5% 25.3%, 59.8% 49%, 55.2% 57.8%, 44.4% 57.2%, 27.8% 47.9%, 35.1% 81.5%, 0% 97.7%, 39.2% 100%, 35.2% 81.4%, 97.2% 52.8%, 63.1% 29.5%)"></div></div><div class="overflow-hidden"><div class="mx-auto max-w-7xl px-6 pb-32 pt-36 sm:pt-60 lg:px-8 lg:pt-32"><div class="mx-auto max-w-2xl gap-x-14 lg:mx-0 lg:flex lg:max-w-none lg:items-center"><div class="relative w-full max-w-xl lg:shrink-0 xl:max-w-2xl"><h1 class="text-4xl font-bold tracking-tight text-gray-900 sm:text-6xl dark:text-white">FLUX AI</h1><p class="mt-6 text-lg leading-8 text-gray-600 sm:max-w-md lg:max-w-none">Unlock the power of Flux AI with Black Forest Labs. Our Flux AI Image Generator transforms your creative ideas into stunning visuals, delivering unmatched quality and innovation with every image.</p><div class="mt-10 flex items-center gap-x-6"><a class="rounded-md bg-indigo-600 px-3.5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600" href="/en/flux/flux-schnell">Get Started for Free</a></div></div><div class="mt-14 flex justify-end gap-8 sm:-mt-44 sm:justify-start sm:pl-20 lg:mt-0 lg:pl-0"><div class="ml-auto w-44 flex-none space-y-8 pt-32 sm:ml-0 sm:pt-80 lg:order-last lg:pt-36 xl:order-none xl:pt-80"><div class="relative"><img src="/images/hero/hero-1.webp" alt="flux ai image generator - A machine generating endless of polaroid images and blowing them up into the air. Realistic National geographic photo" class="aspect-[2/3] w-full rounded-xl bg-gray-900/5 object-cover shadow-lg"/><div class="pointer-events-none absolute inset-0 rounded-xl ring-1 ring-inset ring-gray-900/10"></div></div></div><div class="mr-auto w-44 flex-none space-y-8 sm:mr-0 sm:pt-52 lg:pt-36"><div class="relative"><img src="/images/hero/hero-2.webp" alt="flux ai image generator - macro photography of a miniature little village on top of a flower" class="aspect-[2/3] w-full rounded-xl bg-gray-900/5 object-cover shadow-lg"/><div class="pointer-events-none absolute inset-0 rounded-xl ring-1 ring-inset ring-gray-900/10"></div></div><div class="relative"><img src="/images/hero/hero-3.webp" alt="flux ai image generator - filmic photo of a group of three women on a street downtown, they are holding their hands up the camera" class="aspect-[2/3] w-full rounded-xl bg-gray-900/5 object-cover shadow-lg"/><div class="pointer-events-none absolute inset-0 rounded-xl ring-1 ring-inset ring-gray-900/10"></div></div></div><div class="w-44 flex-none space-y-8 pt-32 sm:pt-0"><div class="relative"><img src="/images/hero/hero-4.webp" alt="flux ai image generator - detailed pen and ink drawing with watercolor infill of a large beautiful castle on a hill above a forest, pastel colored clouds rolling by overhead, a knight on a horse can be seen riding up the winding path to the castle" class="aspect-[2/3] w-full rounded-xl bg-gray-900/5 object-cover shadow-lg"/><div class="pointer-events-none absolute inset-0 rounded-xl ring-1 ring-inset ring-gray-900/10"></div></div><div class="relative"><img src="/images/hero/hero-5.webp" alt="flux ai image generator - thick splotchy oil painting with brush strokes of a large whale floating gently in the night sky high above a city" class="aspect-[2/3] w-full rounded-xl bg-gray-900/5 object-cover shadow-lg"/><div class="pointer-events-none absolute inset-0 rounded-xl ring-1 ring-inset ring-gray-900/10"></div></div></div></div></div></div></div></div></section><section id="features" class="relative z-1 overflow-hidden dark:bg-black dark:text-white lg:py-22.5 xl:py-27.5"><div class="mx-auto mb-12.5 w-full max-w-[703px] px-4 text-center sm:px-8 lg:mb-17.5 xl:px-0"><h2 class="mb-4.5 font-satoshi text-3xl font-bold -tracking-[1.6px] text-black dark:text-white lg:text-heading-4 xl:text-heading-2">FLUX AI Features</h2><p class="mx-auto w-full max-w-[585px] dark:text-gray-4"></p></div><div class="relative z-1 mx-auto w-full max-w-[1170px] px-4 sm:px-8 xl:px-0"><div class="grid grid-cols-1 gap-7.5 sm:grid-cols-2 lg:grid-cols-3"><div class="rounded-[15px] bg-white p-[35px] shadow-1 hover:shadow-features dark:bg-gray-dark"><img alt="FLUX AI Image Generator" loading="lazy" width="40" height="40" decoding="async" data-nimg="1" style="color:transparent" src="/images/features/features-icon-01.svg"/><h3 class="mb-4.5 mt-7.5 font-satoshi text-2xl font-bold text-dark dark:text-white">FLUX AI Image Generator</h3><p class="dark:text-gray-5">The Flux AI Image Generator leverages the advanced FLUX AI model to create high-quality visuals. With options like FLUX.1 Dev, FLUX.1 Schnell, FLUX.1 Pro, FLUX 1.1 Pro and FLUX 1.1 Pro Ultra, some models are available for free use.</p></div><div class="rounded-[15px] bg-white p-[35px] shadow-1 hover:shadow-features dark:bg-gray-dark"><img alt="AI Image Editor" loading="lazy" width="40" height="40" decoding="async" data-nimg="1" style="color:transparent" src="/images/features/features-icon-02.svg"/><h3 class="mb-4.5 mt-7.5 font-satoshi text-2xl font-bold text-dark dark:text-white">AI Image Editor</h3><p class="dark:text-gray-5">The AI Image Editor enhances your FLUX AI experience with features like prompt optimization, image to prompt, background remover, image enhancer, and image restore. Some tools are available free online, perfectly complementing the image generation capabilities of FLUX AI.</p></div><div class="rounded-[15px] bg-white p-[35px] shadow-1 hover:shadow-features dark:bg-gray-dark"><img alt="Free Storage" loading="lazy" width="40" height="40" decoding="async" data-nimg="1" style="color:transparent" src="/images/features/features-icon-03.svg"/><h3 class="mb-4.5 mt-7.5 font-satoshi text-2xl font-bold text-dark dark:text-white">Free Storage</h3><p class="dark:text-gray-5">All generated images by FLUX AI will be saved for you in the cloud for free, and you can manage them anytime.</p></div></div><div class="hidden sm:block"><div class="absolute left-0 top-1/2 -z-1 -translate-y-1/2"><img alt="shape" loading="lazy" width="600" height="600" decoding="async" data-nimg="1" style="color:transparent" src="/images/features/features-shape-01.svg"/></div><div class="absolute right-0 top-1/2 -z-1 -translate-y-1/2"><img alt="shape" loading="lazy" width="800" height="800" decoding="async" data-nimg="1" style="color:transparent" src="/images/features/features-shape-02.svg"/></div></div></div></section><section class="overflow-hidden bg-gray-1 dark:bg-black dark:text-white py-17.5 lg:py-22.5 xl:py-27.5"><div class="mx-auto mb-12.5 w-full max-w-[703px] px-4 text-center sm:px-8 lg:mb-17.5 xl:px-0"><h2 class="mb-4.5 font-satoshi text-3xl font-bold -tracking-[1.6px] text-black dark:text-white lg:text-heading-4 xl:text-heading-2">One-stop AI Image Solution</h2><p class="mx-auto w-full max-w-[585px] dark:text-gray-4"></p></div><div class="mx-auto w-full max-w-[1040px] px-4 sm:px-8 xl:px-0"><div class="flex flex-col items-center justify-between gap-10 sm:flex-row"><div class="w-full max-w-[475px]"><h3 class="mb-4.5 font-satoshi text-2xl font-bold text-black dark:text-white lg:text-3xl xl:text-heading-4">FLUX.1 Schnell</h3><p class="dark:text-gray-5">FLUX.1 Schnell is the fastest image generation model, specifically designed for local development and personal use. As a free AI art generator, FLUX AI offers incredible speed and efficiency, enabling users to quickly generate high-quality images from text descriptions. With FLUX AI, both speed and precision are guaranteed, providing a robust solution for creative workflows.</p><ul class="mt-7.5 flex flex-col gap-3"><li class="flex items-center gap-3"><span><svg width="22" height="22" viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" clip-rule="evenodd" d="M20.1668 10.9999C20.1668 16.0625 16.0628 20.1666 11.0002 20.1666C5.93755 20.1666 1.8335 16.0625 1.8335 10.9999C1.8335 5.93731 5.93755 1.83325 11.0002 1.83325C16.0628 1.83325 20.1668 5.93731 20.1668 10.9999ZM14.6946 8.22212C14.9631 8.4906 14.9631 8.9259 14.6946 9.19439L10.1113 13.7777C9.84281 14.0462 9.40751 14.0462 9.13903 13.7777L7.30569 11.9444C7.03721 11.6759 7.03721 11.2406 7.30569 10.9721C7.57418 10.7036 8.00948 10.7036 8.27797 10.9721L9.62516 12.3193L11.6738 10.2707L13.7224 8.22212C13.9908 7.95363 14.4261 7.95363 14.6946 8.22212Z" fill="#573CFF"></path></svg></span>text-to-image</li></ul><a href="/en/flux/flux-schnell"><button class="bg-indigo-500 text-white w-30 h-8 rounded-md my-6 hover:bg-indigo-600 active:bg-indigo-700 focus:outline-none focus:ring focus:ring-indigo-300">Try it now</button></a></div><div class="w-full max-w-[484px]"><div class="rounded-lg overflow-hidden shadow-xl"><img src="/images/features-img/features-flux-schnell.webp" alt="FLUX.1 Schnell" width="484" height="400"/></div></div></div><div class="flex flex-col items-center justify-between gap-10 pt-17.5 sm:flex-row-reverse lg:pt-22.5 xl:pt-27.5"><div class="w-full max-w-[475px]"><h3 class="mb-4.5 font-satoshi text-2xl font-bold text-black dark:text-white lg:text-3xl xl:text-heading-4">FLUX.1 Dev</h3><p class="dark:text-gray-5">FLUX.1 Dev is an AI picture generator powered by FLUX AI, using a 12 billion parameter rectified flow transformer to create images from text descriptions. FLUX AI enables users to quickly turn prompts into high-quality visuals, making it a powerful tool for both developers and artists seeking precision and creativity.</p><ul class="mt-7.5 flex flex-col gap-3"><li class="flex items-center gap-3"><span><svg width="22" height="22" viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" clip-rule="evenodd" d="M20.1668 10.9999C20.1668 16.0625 16.0628 20.1666 11.0002 20.1666C5.93755 20.1666 1.8335 16.0625 1.8335 10.9999C1.8335 5.93731 5.93755 1.83325 11.0002 1.83325C16.0628 1.83325 20.1668 5.93731 20.1668 10.9999ZM14.6946 8.22212C14.9631 8.4906 14.9631 8.9259 14.6946 9.19439L10.1113 13.7777C9.84281 14.0462 9.40751 14.0462 9.13903 13.7777L7.30569 11.9444C7.03721 11.6759 7.03721 11.2406 7.30569 10.9721C7.57418 10.7036 8.00948 10.7036 8.27797 10.9721L9.62516 12.3193L11.6738 10.2707L13.7224 8.22212C13.9908 7.95363 14.4261 7.95363 14.6946 8.22212Z" fill="#573CFF"></path></svg></span>text-to-image</li><li class="flex items-center gap-3"><span><svg width="22" height="22" viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" clip-rule="evenodd" d="M20.1668 10.9999C20.1668 16.0625 16.0628 20.1666 11.0002 20.1666C5.93755 20.1666 1.8335 16.0625 1.8335 10.9999C1.8335 5.93731 5.93755 1.83325 11.0002 1.83325C16.0628 1.83325 20.1668 5.93731 20.1668 10.9999ZM14.6946 8.22212C14.9631 8.4906 14.9631 8.9259 14.6946 9.19439L10.1113 13.7777C9.84281 14.0462 9.40751 14.0462 9.13903 13.7777L7.30569 11.9444C7.03721 11.6759 7.03721 11.2406 7.30569 10.9721C7.57418 10.7036 8.00948 10.7036 8.27797 10.9721L9.62516 12.3193L11.6738 10.2707L13.7224 8.22212C13.9908 7.95363 14.4261 7.95363 14.6946 8.22212Z" fill="#573CFF"></path></svg></span>image-to-image</li></ul><a href="/en/flux/flux-dev"><button class="bg-indigo-500 text-white w-30 h-8 rounded-md my-6 hover:bg-indigo-600 active:bg-indigo-700 focus:outline-none focus:ring focus:ring-indigo-300">Try it now</button></a></div><div class="w-full max-w-[484px]"><div class="rounded-lg overflow-hidden shadow-xl"><img src="/images/features-img/features-flux-dev.webp" alt="FLUX.1 Dev" width="484" height="400"/></div></div></div><div class="flex flex-col items-center justify-between gap-10 sm:flex-row"><div class="w-full max-w-[475px]"><h3 class="mb-4.5 font-satoshi text-2xl font-bold text-black dark:text-white lg:text-3xl xl:text-heading-4">FLUX.1 Pro</h3><p class="dark:text-gray-5">FLUX.1 Pro is a state-of-the-art AI photo generator, offering top-of-the-line prompt following, visual quality, image detail, and output diversity. Powered by FLUX AI, it turns text descriptions into stunning visuals, ensuring unmatched precision and creativity in every generated image. Ideal for developers and digital artists seeking advanced capabilities.</p><ul class="mt-7.5 flex flex-col gap-3"><li class="flex items-center gap-3"><span><svg width="22" height="22" viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" clip-rule="evenodd" d="M20.1668 10.9999C20.1668 16.0625 16.0628 20.1666 11.0002 20.1666C5.93755 20.1666 1.8335 16.0625 1.8335 10.9999C1.8335 5.93731 5.93755 1.83325 11.0002 1.83325C16.0628 1.83325 20.1668 5.93731 20.1668 10.9999ZM14.6946 8.22212C14.9631 8.4906 14.9631 8.9259 14.6946 9.19439L10.1113 13.7777C9.84281 14.0462 9.40751 14.0462 9.13903 13.7777L7.30569 11.9444C7.03721 11.6759 7.03721 11.2406 7.30569 10.9721C7.57418 10.7036 8.00948 10.7036 8.27797 10.9721L9.62516 12.3193L11.6738 10.2707L13.7224 8.22212C13.9908 7.95363 14.4261 7.95363 14.6946 8.22212Z" fill="#573CFF"></path></svg></span>text-to-image</li><li class="flex items-center gap-3"><span><svg width="22" height="22" viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg"><path fill-rule="ev