      } catch (err) {}
      var connection = w.navigator.connection
      var report = {
        v: 1,
        css: failed.css,
        cssTotal: doc.querySelectorAll('link[rel="stylesheet"][href*="/_next/static/"]').length,
        js: failed.js,
        nextReady: typeof w.next === 'object',
        hosts: Object.keys(hosts).slice(0, 5),
