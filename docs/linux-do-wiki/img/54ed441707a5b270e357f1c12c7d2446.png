      var text = String(e.name || 'Error') + ': ' + String(e.message) + (frame ? ' ' + frame : '')
      return text
        .replace(/[?#][^\s)]*/g, '')
        .replace(/\b(Bearer|Basic|Token)\s+[\w.~+\/=-]+/gi, '$1 [redacted]')
        .replace(/eyJ[\w-]+\.[\w-]+\.[\w-]+/g, '[jwt]')
        .replace(/[\w.+-]+@[\w-]+\.[\w.-]+/g, '[email]')
        .replace(/[\w-]{32,}/g, '[redacted]')
        .slice(0, 200)
    }

    var con = w.console
    var originalError = con && con.error
    if (originalError) {
      con.error = function () {
        try {
          var first = arguments[0]
          if (typeof first === 'string' && first.indexOf(fatalMarker) === 0) {
            if (!fatalSent) {
              fatalSent = true
