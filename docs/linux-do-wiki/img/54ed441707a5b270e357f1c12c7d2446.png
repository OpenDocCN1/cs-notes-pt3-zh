      }
    }

    doc.addEventListener('error', function (event) {
      var target = event.target
      if (!target || !target.tagName) return
      var tag = target.tagName
      var url = (tag === 'LINK' ? target.href : target.src) || ''
      if (url.indexOf('/_next/static/') === -1) return
      if (tag === 'LINK') {
        if ((target.getAttribute('rel') || '').indexOf('stylesheet') === -1) return
