  (function (w, endpoint, settleMs, fallbackMs, maxPerSession, fatalMarker) {
    var doc = w.document
    var path = w.location.pathname.slice(0, 200)
    function currentPath() {
      return w.location.pathname.slice(0, 200)
    }
    var failed = { css: 0, js: 0 }
    var hosts = {}
    var storageKey = '__asset_probe_sent'
    var fatalStorageKey = '__asset_probe_fatal_sent'
    var done = false
    var loaded = false
    var fatalSent = false
    var lastError = ''

