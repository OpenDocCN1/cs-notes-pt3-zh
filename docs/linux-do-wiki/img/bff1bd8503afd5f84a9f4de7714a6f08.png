21Z" stroke="currentColor" stroke-width="2" stroke-linecap="square"></path></svg><div><p class="text-primary/80 text-sm font-medium">Memory across chats</p><p class="text-primary/60 mt-0.5 text-xs leading-relaxed">Remembers your preferences and past conversations</p></div></div><div class="flex items-start gap-3"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" data-slot="icon" class="stroke-[2] mt-px size-[18px] shrink-0 text-primary/30" stroke-width="1.5"><g id="name=edit"><path id="vector" fill-rule="evenodd" clip-rule="evenodd" d="M13.543 4.04269C15.3142 2.27158 18.1858 2.27158 19.957 4.04269C21.7282 5.8139 21.7282 8.68551 19.957 10.4568L11.2314 19.1833C10.4044 20.0103 9.31321 20.5207 8.14844 20.6267L2.89551 21.1042L3.37305 15.8513C3.47901 14.6865 3.99037 13.5953 4.81738 12.7683L13.543 4.04269ZM6.23145 14.1823C5.73523 14.6786 5.42881 15.3341 5.36523 16.0329L5.10449 18.8943L7.9668 18.6345C8.66566 18.5709 9.32018 18.2645 9.81641 17.7683L16.585 10.9987L13 7.41379L6.23145 14.1823ZM18.543 5.45676C17.5528 4.46669 15.9472 4.46669 14.957 5.45676L14.4141 5.99972L17.999 9.58468L18.543 9.04269C19.5331 8.0525 19.5331 6.44691 18.543 5.45676Z" fill="currentColor"></path></g></svg><div><p class="text-primary/80 text-sm font-medium">Canvas for writing</p><p class="text-primary/60 mt-0.5 text-xs leading-relaxed">Long-form editing with inline suggestions</p></div></div><div class="flex items-start gap-3"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" data-slot="icon" class="stroke-[2] mt-px size-[18px] shrink-0 text-primary/30" stroke-width="1.5"><path stroke="currentColor" d="M13.5 3h-3C9.408 5.913 8.024 6.711 4.956 6.201l-1.5 2.598c1.976 2.402 1.976 4 0 6.402l1.5 2.598c3.068-.51 4.452.288 5.544 3.201h3c1.092-2.913 2.476-3.711 5.544-3.2l1.5-2.599c-1.976-2.402-1.976-4 0-6.402l-1.5-2.598c-3.068.51-4.452-.288-5.544-3.201Z"></path><circle cx="12" cy="12" r="2.5" fill="currentColor"></circle></svg><div><p class="text-primary/80 text-sm font-medium">Custom instructions</p><p class="text-primary/60 mt-0.5 text-xs leading-relaxed">Tailor responses to your style and needs</p></div></div><div class="flex items-start gap-3"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" data-slot="icon" class="stroke-[2] mt-px size-[18px] shrink-0 text-primary/30" stroke-width="1.5"><g id="name=share-ios"><g id="vector"><path d="M5 16C5 16.7165 5.00032 17.1938 5.03028 17.5605C5.05924 17.9151 5.11072 18.0777 5.16309 18.1807C5.3069 18.4629 5.5371 18.6931 5.81934 18.8369C5.92228 18.8893 6.0849 18.9408 6.43946 18.9697C6.80616 18.9997 7.28347 19 8 19H16C16.7165 19 17.1938 18.9997 17.5605 18.9697C17.9151 18.9408 18.0777 18.8893 18.1807 18.8369C18.4629 18.6931 18.6931 18.4629 18.8369 18.1807C18.8893 18.0777 18.9408 17.9151 18.9697 17.5605C18.9997 17.1938 19 16.7165 19 16V14H21V16C21 16.6836 21.0011 17.2566 20.9629 17.7236C20.9238 18.2023 20.8382 18.6571 20.6182 19.0889C20.2826 19.7474 19.7474 20.2826 19.0889 20.6182C18.6571 20.8382 18.2023 20.9238 17.7236 20.9629C17.2566 21.001 16.6836 21 16 21H8C7.31644 21 6.74342 21.001 6.27637 20.9629C5.79772 20.9238 5.34294 20.8382 4.91114 20.6182C4.25262 20.2826 3.71739 19.7474 3.38184 19.0889C3.16182 18.6571 3.07623 18.2023 3.03711 17.7236C2.99895 17.2566 3 16.6836 3 16V14H5V16Z" fill="currentColor"></path><path d="M17.7031 8.04297L16.2891 9.45703L12.9961 6.16406V16H10.9961V6.16406L7.70313 9.45703L6.28907 8.04297L11.9961 2.33594L17.7031 8.04297Z" fill="currentColor"></path></g></g></svg><div><p class="text-primary/80 text-sm font-medium">Shareable conversations</p><p class="text-primary/60 mt-0.5 text-xs leading-relaxed">Share any thread with a public link</p></div></div><div class="flex items-start gap-3"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" data-slot="icon" class="stroke-[2] mt-px size-[18px] shrink-0 text-primary/30" stroke-width="1.5"