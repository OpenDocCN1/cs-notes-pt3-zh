<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Flux</title>
    <style>
      body {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
        margin: 0;
        padding: 20px;
        box-sizing: border-box;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
          "Helvetica Neue", Arial, sans-serif;
      }
      .container {
        width: 100%;
        max-width: 800px;
      }
      .button-container {
        display: flex;
        justify-content: flex-end;
        margin-bottom: 20px;
      }
      .home-button {
        border-radius: 6px;
        background-color: #6366f1;
        padding: 10px 14px;
        font-size: 14px;
        font-weight: 600;
        color: white;
        box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
        cursor: pointer;
        border: none;
        transition: background-color 0.2s;
      }
      .home-button:hover {
        background-color: #4f46e5;
      }
      .home-button:focus-visible {
        outline: 2px solid #6366f1;
        outline-offset: 2px;
      }
    </style>
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-6188577279458490" crossorigin="anonymous"></script>
    <!-- <script>(function(d,z,s){s.src='https://'+d+'/400/'+z;try{(document.body||document.documentElement).appendChild(s)}catch(e){}})('vemtoutcheeg.com',8482352,document.createElement('script'))</script> -->
  </head>
  <body>
    <div class="container">
      <div class="button-container">
        <button class="home-button" onclick="window.location.href='/'">
          Home
        </button>
      </div>
      <gradio-app
        src="https://black-forest-labs-flux-1-schnell.hf.space"
      ></gradio-app>
    </div>

    <script
      type="module"
      src="https://gradio.s3-us-west-2.amazonaws.com/4.40.0/gradio.js"
    ></script>

    <div style="display: none;">
      <!-- Google tag (gtag.js) -->
      <script
        async
        src="https://www.googletagmanager.com/gtag/js?id=G-VZR75L1LJB"
      ></script>
      <script>
        window.dataLayer = window.dataLayer || [];
        function gtag() {
          dataLayer.push(arguments);
        }
        gtag("js", new Date());

        gtag("config", "G-VZR75L1LJB");
      </script>
    </div>
  </body>
</html>
