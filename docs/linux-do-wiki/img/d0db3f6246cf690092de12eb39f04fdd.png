ex gap-4\",\"children\":[[\"$\",\"span\",null,{\"className\":\"flex size-6 shrink-0 items-center justify-center rounded-sm border border-primary font-mono text-xs text-primary\",\"children\":12}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"div\",null,{\"className\":\"mb-2 flex items-center justify-between\",\"children\":[\"$\",\"h3\",null,{\"className\":\"text-xl font-bold text-foreground\",\"children\":\"什么是免费的 AI 图像生成器？\"}]}],[\"$\",\"p\",null,{\"className\":\"text-base text-foreground/70 leading-relaxed\",\"children\":\"免费的 AI 图像生成器是一种把文字提示词转换成图片且不收取费用的工具。Raphael AI 让你直接在浏览器中生成图片，无需注册，也无需信用卡。更重要的是，登录用户在 Basic 模式（不含 Fast Mode）下可以真正无限免费生成，只需短暂排队。你也可以使用每日免费 credits 跳过队列，或解锁更高分辨率的模型。\"}]]}]]}]\n3c:[\"$\",\"div\",\"12\",{\"className\":\"flex gap-4\",\"children\":[[\"$\",\"span\",null,{\"className\":\"flex size-6 shrink-0 items-center justify-center rounded-sm border border-primary font-mono text-xs text-primary\",\"children\":13}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"div\",null,{\"className\":\"mb-2 flex items-center justify-between\",\"children\":[\"$\",\"h3\",null,{\"className\":\"text-xl font-bold text-foreground\",\"children\":\"AI 如何根据文字生成图片？\"}]}],[\"$\",\"p\",null,{\"className\":\"text-base text-foreground/70 leading-relaxed\",\"children\":\"你输入一段描述，也就是提示词，AI 模型会理解其中的词语、对象、风格和构图要求，并渲染出匹配的图像。Raphael AI 会把提示词路由到 Seedream 3.5、Seedream、Nano Banana 等模型，并在几秒内返回结果。提示词越具体，结果越接近你的想法。\"}]]}]]}]\n3d:[\"$\",\"div\",\"13\",{\"className\":\"flex gap-4\",\"children\":[[\"$\",\"span\",null,{\"className\":\"flex size-6 shrink-0 items-center justify-center rounded-sm border border-primary font-mono text-xs text-primary\",\"children\":14}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"div\",null,{\"className\":\"mb-2 flex items-center justify-between\",\"children\":[\"$\",\"h3\",null,{\"className\":\"text-xl font-bold text-foreground\",\"children\":\"使用 AI 生成图片合法吗？\"}]}],[\"$\",\"p\",null,{\"className\":\"text-base text-foreground/70 leading-relaxed\",\"children\":\"是的，在大多数国家和地区，使用 AI 生成图片是合法的。使用 Raphael AI 时，你拥有自己创建图片的权利，并可以用于个人项目。商业用途适用于付费套餐，并受我们的服务条款和适用法律约束。具体使用场景仍建议检查当地法规。\"}]]}]]}]\n3e:[\"$\",\"div\",\"14\",{\"className\":\"flex gap-4\",\"children\":[[\"$\",\"span\",null,{\"className\":\"flex size-6 shrink-0 items-center justify-center rounded-sm border border-primary font-mono text-xs text-primary\",\"children\":15}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"div\",null,{\"className\":\"mb-2 flex items-center justify-between\",\"children\":[\"$\",\"h3\",null,{\"className\":\"text-xl font-bold text-foreground\",\"children\":\"Raphael AI 安全并保护隐私吗？\"}]}],[\"$\",\"p\",null,{\"className\":\"text-base text-foreground/70 leading-relaxed\",\"children\":\"是的。我们采用最小化数据收集原则：未登录用户的请求通常只会临时处理，不会保存到历史记录，除非在 10 "])</script><script>self.__next_f.push([1,"分钟内登录保存结果。登录用户只保留账户、历史记录和安全所必需的数据。我们不会出售你的提示词或图片。\"}]]}]]}]\n3f:[\"$\",\"div\",\"15\",{\"className\":\"flex gap-4\",\"children\":[[\"$\",\"span\",null,{\"className\":\"flex size-6 shrink-0 items-center justify-center rounded-sm border border-primary font-mono text-xs text-primary\",\"children\":16}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"div\",null,{\"className\":\"mb-2 flex items-center justify-between\",\"children\":[\"$\",\"h3\",null,{\"className\":\"text-xl font-bold text-foreground\",\"children\":\"我可以将 AI 生成图片用于商业用途吗？\"}]}],[\"$\",\"p\",null,{\"className\":\"text-base text-foreground/70 leading-relaxed\",\"children\":\"付费套餐用户可以根据我们的服务条款和适用法律，将生成图片用于商业用途。免费用户可以将图片用于个人和其他非商业用途。你保留对自己生成图片的所有权。\"}]]}]]}]\n40:[\"$\",\"div\",\"16\",{\"className\":\"flex gap-4\",\"children\":[[\"$\",\"span\",null,{\"className\":\"flex size-6 shrink-0 items-center justify-center rounded-sm border border-primary font-mono text-xs text-primary\",\"children\":17}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"div\",null,{\"className\":\"mb-2 flex items-center justify-between\",\"children\":[\"$\",\"h3\",null,{\"className\":\"text-xl font-bold text-foreground\",\"children\":\"最好的免费 AI 图像生成器是什么？\"}]}],[\"$\",\"p\",null,{\"className\":\"text-base text-foreground/70 leading-relaxed\",\"children\":\"最好的免费 AI 图像生成器应同时具备图像质量、速度和无付费墙门槛。Raphael AI 是一个真正免费的选择：Seedream 3.5 模型消耗 0 credits，开始使用无需注册；登录后，Basic 模式（不含 Fast Mode）提供无限免费生成。每日免费 credits 和付费套餐可帮助你跳过队列，并使用 Seedream、Nano Banana 等模型获得更清晰的结果。\"}]]}]]}]\n41:[\"$\",\"div\",\"17\",{\"className\":\"flex gap-4\",\"children\":[[\"$\",\"span\",null,{\"className\":\"flex size-6 shrink-0 items-center justify-center rounded-sm border border-primary font-mono text-xs text-primary\",\"children\":18}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"div\",null,{\"className\":\"mb-2 flex items-center justify-between\",\"children\":[\"$\",\"h3\",null,{\"className\":\"text-xl font-bold text-foreground\",\"children\":\"什么是无门槛 AI 图像生成器？\"}]}],[\"$\",\"p\",null,{\"className\":\"text-base text-foreground/70 leading-relaxed\",\"children\":\"无门槛 AI 图像生成器会从基础体验中移除强制注册、信用卡和生成次数限制等障碍。使用 Raphael AI，你可以直接在浏览器开始生成，无需账户，也无需信用卡。登录后，Basic 模式（不含 Fast Mode）提供无限免费生成；如果想跳过队列或使用更高分辨率模型，可以使用每日 credits 或付费套餐。我们仍会执行标准内容规范，确保安全和合法使用。\"}]]}]]}]\n42:[\"$\",\"div\",\"18\",{\"className\":\"flex gap-4\",\"children\":[[\"$\",\"span\",null,{\"className\":\"flex size-6 shrink-0 items-center justify-center rounded-sm border border-primary font-mono text-xs text-primary\",\"children\":19}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"div\",null,{\"className\":\"mb-2 flex items-center justify-between\",\"children\":[\"$\",\"h3\",null,{\"className\":\"text-xl font-bold text-foreground\",\"children\":\"“无门槛”是否意味着图像质量更低？\"}]}],[\"$\",\"p\",null,{\"className\":\"text-base text-foreground/70 leading-relaxed\",\"children\":\"不是。更少的使用障碍并不代表输出质量更弱。Raphael AI 的免费 Basic 模型生成速度很快，登录用户还可以切换到 Seedream 4.5/5.0（最高 2K）和 Nano Banana Pro 等更高分辨率模型，以获得更丰富的细节。你可以根据任务选择免费或付费模型。\"}]]}]]}]\n43:[\"$\",\"div\",null,{\"className\":\"flex flex-col\",\"children\":[[\"$\",\"div\",null,{\"className\":\"font-medium tracking-tight leading-5\",\"children\":\"Emma Zhang\"}],[\"$\",\"div\",null,{\"className\":\"leading-5 opacity-60 tracking-tight\",\"children\":\"内容创作者\"}]]}]\n44:[\"$\",\"div\",\"1-2\",{\"className\":\"p-10 rounded-3xl border shadow-lg shadow-primary/10 max-w-xs w-full\",\"children\":[[\"$\",\"div\",null,{\"children\":\"它的细节表现无与伦比。作为一名游戏开发者，Raphael AI 图像生成器已成为我们概念设计的首选工具。\"}],[\"$\",\"div\",null,{\"className\":\"flex items-center gap-2 mt-5\",\"children\":[[\"$\",\"img\",null,{\"alt\":\"Kevin Wu\",\"loading\":\"lazy\",\"width\":40,\"height\":40,\"decoding\":\"async\",\"className\":\"h-10 w-10 rounded-full object-cover\",\"style\":\"$31:props:children:props:children:0:props:children:2:props:children:1:props:children:0:props:style\",\"srcSet\":\"/_next/image?url=%2Ftestimonials%2Fkevin-wu.webp\u0026w=48\u0026q=75 1x, /_next/image?url=%2Ftestimonials%2Fkevin-wu.webp\u0026w=96\u0026q=75 2x\",\"src\":\"/_next/image?url=%2Ftestimonials%2Fkevin-wu.webp\u0026w=96\u0026q=75\"}],[\"$\",\"div\",null,{\"className\":\"flex flex-col\",\"children\":[[\"$\",\"div\",null,{\"className\":\"font-medium tracking-tight leading-5\",\"children\":\"Kevin Wu\"}],[\"$\",\"div\",null,{\"className\":\"leading-5 opacity-60 tracking-tight\",\"children\":\"游戏概念艺术家\"}]]}]]}]]}]\n45:[\"$\",\"img\",null,{\"alt\":\"Tom Anderson\",\"loading\":\"lazy\",\"width\":40,\"height\":40,\"decoding\":\"async\",\"className\":\"h-10 w-10 rounded-full object-cover\",\"style\":\"$32:props:children:props:children:0:props:children:1:props:children:1:props:children:0:props:style\",\"srcSet\":\"/_next/image?url=%2Ftestimonials%2Ftom-anderson.webp\u0026w=48\u0026q=75 1x, /_next/image?url=%2Ftestimonials%2Ftom-anderson.webp\u0026w=96\u0026q=75 2x\",\"src\":\"/_next/image?url=%2Ftestimonials%2Ftom-anderson.webp\u0026w=96\u0026q=75\"}]\n46:[\"$\",\"div\",null,{\"className\":\"flex flex-col\",\"children\":[[\"$\",\"div\",null,{\"className\":\"font-medium tracking-tight leading-5\",\"children\":\"Tom Anderson\"}],[\"$\",\"div\",null,{\"className\":\"leading-5 opacity-60 tracking-tight\",\"children\":\"广告创意总监\"}]]}]\n47:[\"$\",\