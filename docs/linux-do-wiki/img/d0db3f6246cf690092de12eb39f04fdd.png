_failed_message\":\"邮箱验证失败：\",\"invalid_link\":\"无效的验证链接\",\"verification_error\":\"验证过程中发生错误\",\"back_to_home\":\"返回首页\",\"sign_in_again\":\"重新登录\",\"resend_verification\":\"重新发送验证邮件\",\"email_required\":\"请输入邮箱地址\",\"invalid_email_format\":\"邮箱格式无效\",\"resend_success\":\"验证邮件已发送成功！请检查收件箱。\",\"rate_limit_error\":\"请求过于频繁，请稍后再试\",\"upload_rate_limit_retry_seconds\":\"上传过于频繁，请在约{count}秒后重试。\",\"upload_rate_limit_retry_minutes\":\"上传过于频繁，请在约{count}分钟后重试。\",\"resend_failed\":\"验证邮件发送失败\",\"network_error\":\"网络错误，请重试\",\"enter_email\":\"输入您的邮箱地址\",\"email_placeholder\":\"your-email@example.com\",\"sending\":\"发送中...\",\"cancel\":\"取消\",\"tabs\":{\"image\":\"图片\",\"video\":\"视频\"},\"sending_email\":\"正在发送验证邮件...\",\"email_sent_success\":\"✅ 验证邮件已发送！\",\"check_inbox_instruction\":\"请检查收件箱和垃圾邮件文件夹，邮件通常会在几分钟内送达。\",\"rate_limit_title\":\"⏰ 请稍等后再发送\",\"rate_limit_suggestion\":\"为防止垃圾邮件，我们会限制验证邮件的发送频率。请稍后再试。\",\"server_error\":\"⚠️ 服务器暂时不可用\",\"server_error_suggestion\":\"服务器当前遇到问题，请稍后再试。\",\"network_error_suggestion\":\"请检查网络连接后重试。\",\"retry_now\":\"🔄 立即重试\",\"root_email_account_limit\":\"此邮箱关联的账号数量已达到上限，无法验证该账号。\",\"root_email_blocked\":\"此邮箱当前无法完成验证。如有疑问，请联系支持。\"},\"reset_password\":{\"title\":\"重置密码\",\"description\":\"请输入您的新密码\",\"new_password\":\"新密码\",\"new_password_placeholder\":\"输入新密码\",\"confirm_new_password\":\"确认新密码\",\"confirm_new_password_placeholder\":\"再次输入新密码\",\"reset_button\":\"重置密码\",\"success\":\"密码重置成功！\",\"success_description\":\"您的密码已成功重置。请使用新密码登录。\",\"link_expired\":\"链接已过期\",\"link_expired_description\":\"密码重置链接可能已过期或无效。请请求新的密码重置。\",\"request_new\":\"请求新的\",\"email_sent_title\":\"邮件已发送！\",\"email_sent_description\":\"如果该电子邮件已注册，您将收到一封包含密码重置链接的电子邮件。\",\"check_email\":\"请检查您的电子邮件（包括垃圾邮件文件夹）。\",\"send_reset_link\":\"发送重置链接\",\"back_to_login\":\"返回登录\",\"back_to_home\":\"返回主页\",\"error_sending\":\"发送失败，请重试\",\"password_mismatch\":\"密码不匹配\",\"password_too_short\":\"密码必须至少包含 8 个字符\",\"invalid_link\":\"重置链接无效\",\"reset_failed\":\"重置密码失败，请重试\",\"resend_email\":\"未收到邮件？重新发送\",\"sending_reset_email\":\"正在发送密码重置邮件...\",\"rate_limit_title\":\"⏰ 请稍后再发送\",\"rate_limit_message\":\"为防止垃圾邮件，我们限制了密码重置请求。请稍后再试。\",\"email_not_found\":\"未找到电子邮件\",\"email_not_registered\":\"此电子邮件地址未注册。请检查电子邮件或注册。\",\"please_try_again_later\":\"请稍后再试\",\"check_email_for_link\":\"请检查您的电子邮件以获取密码重置链接。\",\"network_error\":\"网络连接错误\",\"check_connection_retry\":\"请检查您的互联网连接并重试。\",\"email_delivery_note\":\"电子邮件可能需要几分钟才能到达。如有需要，请检查您的垃圾邮件文件夹。\"},\"credits\":{\"remaining\":\"剩余积分\",\"dailyReset\":\"每日重置\",\"monthlyReset\":\"每月重置\",\"insufficientCredits\":\"积分不足\",\"creditsUsed\":\"已用积分\",\"creditsRefunded\":\"积分已退还\",\"now\":\"现在\",\"timeUnits\":{\"day\":\"天\",\"days\":\"天\",\"hour\":\"小时\",\"hours\":\"小时\",\"minute\":\"分钟\",\"minutes\":\"分钟\",\"second\":\"秒\",\"seconds\":\"秒\"}},\"upgradeModal\":{\"needMoreCredits\":\"需要更多积分\",\"youNeedCredits\":\"您需要 {required} 积分才能使用 {feature}\",\"thisFeature\":\"此功能\",\"currentCredits\":\"您的积分\",\"requiredCredits\":\"所需积分\",\"yourCredits\":\"您的积分\",\"shortage\":\"还差 {amount}\",\"moreNeeded\":\"更多积分\",\"upgradeOptions\":\"选择一个套餐以获取更多积分：\",\"creditsPerMonth\":\"{amount} 积分/月\",\"creditsPerDay\":\"积分/天\",\"resetsIn\":\"在 {time} 重置\",\"upgradeForInstantAccess\":\"升级以即时访问：\",\"noWatermark\":\"无水印\",\"from\":\"从\",\"month\":\"月\",\"later\":\"稍后\",\"viewPlans\":\"查看所有套餐\",\"freeUserNote\":\"免费用户每日获得 {amount} 积分\",\"nextReset\":\"下次重置: {time}\",\"currentPlan\":\"当前套餐\",\"recommendedPlan\":\"推荐\",\"description\":\"您有 {current} 积分，但需要 {required} 积分才能使用 {feature}。\",\"unlockFeature\":\"解锁 {feature}\",\"unlockPremiumFeatures\":\"解锁专业版功能\",\"exploreDescription\":\"升级以使用具有增强质量和更快生成速度的 {feature}。\",\"exploreThisFeature\":\"此功能\",\"premiumFeatures\":\"专业版功能\",\"upgradeToAccess\":\"升级以使用具有专业版质量的 {feature}\",\"insufficientCredits\":{\"title\":\"购买套餐获取更多积分\",\"close\":\"关闭\",\"shortageWithAmount\":\"额度不足 · 还差 {amount} 积分\",\"shortageSimple\":\"额度不足\",\"sidebarUpgrade\":{\"eyebrow\":\"年付套餐立省 50%\",\"title\":\"升级，解锁完整创作体验\",\"subscriberEyebrow\":\"你的订阅\",\"subscriberTitle\":\"查看套餐或管理订阅\",\"manage\":\"管理\"},\"watermarkFreeDownload\":{\"eyebrow\":\"无水印高清下载\",\"title\":\"升级套餐，下载无水印高清原图\"},\"speedUpWaiting\":{\"eyebrow\":\"升级后速度最高可提升约 8 倍\",\"title\":\"升级开启快速队列\",\"description\":\"\"},\"paidModel\":{\"eyebrow\":\"高级模型权益\",\"title\":\"升级解锁高级模型\",\"description\":\"升级后可解锁全部高级模型，并且享受高级模型专属折扣价。\"},\"upgradeNow\":\"立即升级\",\"billing\":{\"monthly\":\"月付\",\"yearly\":\"年付\",\"discount\":\"省 50%\"},\"plans\":{\"recommended\":\"推荐\",\"priceUnit\":\"USD/月\",\"creditsPerMonth\":\"{amount} 积分 / 月\",\"pro\":{\"name\":\"Pro\",\"benefit\":\"高级模型、无水印、更快队列\"},\"ultimate\":{\"name\":\"Ultimate\",\"benefit\":\"全部 Pro 权益、更多积分、最高优先级\"},\"max\":{\"name\":\"至尊版\",\"benefit\":\"全部 Ultimate 权益、双倍积分\"}},\"models\":{\"title\":\"升级后可解锁全部高级模型，并享受专属折扣\",\"items\":{\"raphaelImage\":\"Seedream 3.5 Pro\",\"nanoBanana\":\"Nano Banana\",\"nanoBananaPro\":\"Nano Banana Pro\",\"nanoBanana2\":\"Nano Banana 2\",\"gptImage2\":\"GPT Image 2\",\"gptImage15\":\"GPT Image 1.5\",\"seedream50\":\"Seedream 5.0\",\"seedream45\":\"Seedream 4.5\",\"raphaelVideo\":\"MiniMax H3 Turbo\",\"seedance25\":\"Seedance 2.5\",\"minimaxH3\":\"MiniMax H3\",\"veo31\":\"Veo 3.1\",\"kling30\":\"Kling 3.0\",\"gptImage25\":\"GPT Image 2.5\"},\"shortTitle\":\"升级后可解锁全部高级模型\"},\"benefits\":{\"title\":\"升级后可解锁以下权益\",\"creditsPerMonth\":\"积分 / 月\",\"maxImagesPrefix\":\"最多\",\"maxImagesSuffix\":\"张快速图片\",\"imageEstimateHint\":\"按快速模式图片约 1 积分/张估算，实际消耗会随模型、画质和数量变化。\",\"maxVideosPrefix\":\"最多\",\"maxVideosSuffix\":\"条基础视频\",\"videoEstimateHint\":\"按 {model} {resolution}、{duration} 秒、单个视频 {credits} 积分估算；其他视频模型、分辨率和时长会消耗更多积分。\",\"proAccess\":\"高级模型、无水印、更快队列\",\"ultimateAccess\":\"全部 Pro 权益、更多积分、最高优先级\",\"commercial\":\"可商用作品授权\",\"noWatermarkDownload\":\"无水印高清下载\",\"aiTools\":\"AI 工具：编辑、扩图、去背景\",\"batchImageUpscaling\":\"AI 工具批量使用\",\"privacy\":\"隐私权益和无广告体验\",\"templates\":\"更多图片工具和模板\",\"maxAccess\":\"全部 Ultimate 权益、双倍积分\"},\"cycleExhausted\":{\"title\":\"本周期积分已用完\",\"description\":\"额度将在下个周期发放。\",\"confirm\":\"知道了\"},\"creditPacks\":{\"tab\":\"积分包\",\"benefitsTitle\":\"支付后获得积分包\",\"regularReceive\":\"普通用户可获得 \u003camount\u003e\u003c/amount\u003e 积分\",\"subscriberReceive\":\"订阅用户可获得 \u003camount\u003e\u003c/amount\u003e 积分（同价多得 50%）\",\"validForMonths\":\"{months} 个月有效\",\"expiryOrder\":\"优先消耗最早过期的积分\",\"cycleExhaustedDescription\":\"你的订阅权益仍然保留。可以购买一次性积分包临时补充额度，订阅用户同价多得 50% 积分。\",\"viewPacks\":\"查看积分包\"}},\"features\":{\"higherResolution\":\"更高分辨率输出\",\"highestResolution\":\"最高分辨率输出\",\"betterQuality\":\"更好的图像质量\",\"bestQuality\":\"最佳图像质量\",\"priorityProcessing\":\"优先处理，无需等待\",\"creditsPerGeneration\":\"每次生成消耗 {credits} 积分\",\"enhancedResolution\":\"增强的质量和分辨率\",\"enhancedQuality\":\"增强的质量\",\"superiorQuality\":\"卓越的图像质量\",\"usesCredits\":\"消耗 {credits} 积分\",\"fewer\":\"更少\"},\"creditPacks\":{\"title\":\"购买一次性积分包\",\"description\":\"你的订阅权益保持不变。积分包只用于一次性补充额度，订阅用户可多得 50% 积分。\",\"button\":\"查看积分包\"}},\"membership\":{\"upgrade_prompt\":{\"title\":\"需要更多积分\",\"description\":\"您有 {current} 积分，但需要 {required} 积分才能使用 {feature}。\",\"current_credits\":\"您的积分\",\"required_credits\":\"所需积分\",\"shortage\":\"还差 {amount}\",\"choose_plan\":\"选择一个套餐以获取更多积分：\",\"current_plan\":\"当前套餐\",\"recommended\":\"推荐\",\"per_month\":\"{amount} 积分/月\",\"from_price\":\"每月 ${price} 起\",\"maybe_later\":\"稍后\",\"view_all_plans\":\"查看所有套餐\",\"free_user_note\":\"免费用户每日获得 {amount} 积分\",\"next_reset\":\"下次重置: {time}\"},\"plans\":{\"free\":{\"name\":\"免费\",\"credits\":\"每日 10 积分\"},\"pro\":{\"name\":\"专业版\",\"credits\":\"每月 2,000 积分\"},\"ultimate\":{\"name\":\"旗舰版\",\"credits\":\"每月 5,000 积分\"},\"max\":{\"name\":\"至尊版\",\"credits\":\"每月 10,000 积分\"}}},\"studio\":{\"page\":{\"title\":\"创意板 (Ideaboard)\",\"welcome\":\"无限画布。无限创意。\",\"description\":\"在一个无限的工作空间中，将模糊的想法转化为令人惊叹的视觉效果。\",\"newProject\":\"新建创意板\",\"noProjects\":\"暂无项目\",\"noProjectsDescription\":\"创建您的第一个 AI 驱动的视觉板\",\"createFirst\":\"创建您的第一个项目\",\"exploreIdeas\":\"探索您的想法\",\"pickExample\":\"选择一个示例，看看创意板能做什么。\",\"creatingBoard\":\"正在创建您的画板...\",\"sortRecent\":\"最近\",\"sortAlphabetical\":\"按字母顺序\",\"sortOldest\":\"最早\",\"newModeBadge\":\"新模式\",\"badges\":{\"aiDesignCanvas\":\"AI 设计画布\",\"generateRefine\":\"生成与精炼\",\"contextAware\":\"上下文感知\",\"boundlessBoard\":\"无限画板\"}},\"examples\":{\"party\":{\"title\":\"策划派对\",\"description\":\"为您的下一次庆祝活动创建情绪板\"},\"ideas\":{\"title\":\"想象新想法\",\"description\":\"头脑风暴并可视化概念\"},\"fun\":{\"title\":\"做些有趣的事\",\"description\":\"在 AI 辅助下表达创造力\"}},\"faq\":{\"label\":\"常见问题\",\"title\":\"Raphael Studio 常见问题\",\"description\":\"关于 Studio 模式、画板和核心工具的快速解答。\",\"items\":{\"mode\":{\"title\":\"什么是 Raphael Studio 模式？\",\"description\":\"它是一个无限画布工作区。单个画板可以容纳多个图像、文本块和生成迭代，以实现持续探索。\"},\"difference\":{\"title\":\"Studio 与普通模式有何不同？\",\"description\":\"普通模式侧重于单次运行和结果列表；Studio 侧重于画板管理、拖放布局和画布内工具，如变体、移除背景和扩展。\"},\"createBoard\":{\"title\":\"如何创建或打开画板？\",\"description\":\"在 /studio 输入提示词即可创建并进入新画板，或从项目列表中打开任何现有画板。\"},\"reference\":{\"title\":\"Studio 是否支持图生图或多参考？\",\"description\":\"是的。您最多可以使用 3 个参考图像，画板会自动排列它们。\"},\"tools\":{\"title\":\"画布上有什么工具可用？\",\"description\":\"选择一个图像以生成变体、移除背景或扩展。您还可以添加文本块、缩放和管理布局。\"},\"shareExport\":{\"title\":\"我可以分享或导出画板吗？\",\"description\":\"您可以创建一个公开分享链接（随时禁用）并导出 PNG，背景可选择透明、白色或黑色。\"},\"autosave\":{\"title\":\"画板会自动保存吗？\",\"description\":\"是的。画板会自动保存，并在您离开前保存。项目列表会显示缩略图和更新时间。\"},\"credits\":{\"title\":\"我需要登录或使用积分吗？\",\"description\":\"生成、变体、移除背景和扩展需要登录并消耗积分；如果积分用完，您会看到升级或登录提示。\"}}},\"board\":{\"delete\":\"删除\",\"deleteTitle\":\"删除项目\",\"deleteDescription\":\"您确定要删除此项目吗？此操作无法撤销。\",\"cancel\":\"取消\",\"tabs\":{\"image\":\"图像\",\"video\":\"视频\"},\"noPreview\":\"无预览\",\"example\":\"示例\",\"experiment\":\"实验\",\"untitled\":\"未命名\",\"back\":\"返回画板\",\"home\":\"主页\",\"projects\":\"项目\",\"share\":\"分享\",\"viewOnly\":\"仅查看\",\"shareDialog\":{\"title\":\"分享画板\",\"description\":\"创建一个公开链接以与他人分享此画板。\",\"descriptionShared\":\"拥有此链接的任何人都可以查看此画板。\",\"publishTitle\":\"发布到网络\",\"publishDescription\":\"将此画板发布到网络，以便您可以与朋友分享。\",\"createLink\":\"创建公开链接\",\"creating\":\"正在创建链接...\",\"publicLink\":\"公开链接\",\"copy\":\"复制\",\"copied\":\"已复制！\",\"stopSharing\":\"停止分享\",\"publicNotice\":\"此画板当前是公开的。访问者可以查看画板但无法进行更改。\",\"toast\":{\"createdTitle\":\"分享链接已创建\",\"createdDesc\":\"拥有此链接的任何人都可以查看此画板。\",\"stoppedTitle\":\"分享已停止\",\"stoppedDesc\":\"公开链接已禁用。\",\"copied\":\"链接已复制到剪贴板。\",\"error\":\"更新分享设置失败。\"}},\"moreOptions\":\"更多选项\",\"rename\":\"重命名\",\"export\":\"导出\",\"exportTransparent\":\"透明\",\"exportWhite\":\"白色\",\"exportBlack\":\"黑色\",\"renameTitle\":\"重命名画板\",\"renameDescription\":\"为该画板输入一个新名称\",\"renamePlaceholder\":\"输入画板标题\",\"renameCancel\":\"取消\",\"renameSave\":\"保存\"},\"toolbar\":{\"select\":{\"label\":\"选择块\",\"description\":\"按住空格键平移画板\"},\"hand\":{\"label\":\"平移画板\",\"description\":\"拖动以移动画布\"},\"text\":{\"label\":\"添加文本\",\"description\":\"点击放置一个文本块\"},\"upload\":{\"label\":\"上传图像\",\"description\":\"从您的设备导入图像\"},\"zoomIn\":{\"label\":\"放大\",\"description\":\"Cmd/Ctrl + =\"},\"zoomOut\":{\"label\":\"缩小\",\"description\":\"Cmd/Ctrl + -\"},\"resetZoom\":{\"label\":\"重置缩放\",\"description\":\"Cmd/Ctrl + 0\"},\"slider\":{\"label\":\"缩放滑块\",\"description\":\"拖动或点击以调整 (25%-150%)\"}},\"selectionBar\":{\"limitHint\":\"保留最近选择的 3 张图像\",\"limitLabel\":\"最多选择 3 张图像\",\"limitTooltip\":\"您最多可以选择 3 张图像。最近选择的图像将保留用于混合。\",\"clear\":\"清除选择\",\"remove\":\"从选择中移除\"},\"loading\":{\"board\":\"正在加载画板...\",\"uploading\":\"正在上传图像...\",\"exportTitle\":\"正在导出高分辨率图像\",\"exportDescription\":\"请稍候，这只需要几秒钟...\",\"generationMessages\":[\"完成\",\"执行\",\"实现\",\"烘焙\",\"酝酿\",\"计算\",\"思考\",\"搅动\",\"合并\",\"构思\",\"计算\",\"施展\",\"考虑\",\"烹饪\",\"制作\",\"创造\",\"处理\",\"构思\",\"决定\",\"执行\",\"实现\",\"锻造\",\"形成\",\"生成\",\"孵化\",\"组织\",\"鸣笛\",\"忙碌\",\"构思\",\"推断\",\"显化\",\"腌制\",\"闲逛\",\"沉思\",\"聚集\",\"沉思\",\"过滤\",\"沉思\",\"打磨\",\"反刍\",\"搬运\",\"剥壳\",\"慢炖\",\"揉捏\",\"合成\",\"思考\",\"转化\",\"共振\",\"忙碌\"],\"generationStatus\":\"处理中...\"},\"prompt\":{\"clearSelection\":\"清除选择\",\"multiImageHint\":\"混合 {count} 张图像\",\"editHint\":\"描述要编辑此图像的更改\",\"input\":{\"placeholderCreate\":\"你想创造什么？\",\"