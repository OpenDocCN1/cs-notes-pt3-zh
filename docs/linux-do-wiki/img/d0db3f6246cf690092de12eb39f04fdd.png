edia (min-width: 1024px) {\n                [data-critical-hero] .hero-lead {\n                  display: block;\n                  margin-top: 12px;\n                  font-size: 18px;\n                  color: rgba(255, 255, 255, 0.82);\n                }\n                [data-critical-hero] .hero-badges {\n                  display: flex;\n                  flex-wrap: wrap;\n                  gap: 8px;\n                  justify-content: center;\n                  margin-top: 24px;\n                  min-height: 28px;\n                }\n              }\n              [data-critical-hero] .hero-badge {\n                display: inline-flex;\n                align-items: center;\n                padding: 6px 10px;\n                border-radius: 9999px;\n                font-size: 12px;\n                font-weight: 600;\n                color: #f59e0b;\n                background: rgba(245, 158, 11, 0.1);\n                border: 1px solid rgba(245, 158, 11, 0.2);\n              }\n              /* Home hero keeps one compact benefit line on mobile and restores\n                 the full subtitle + badges from the tablet breakpoint. */\n              [data-critical-hero][data-hero-home] {\n                padding: 16px 0 12px;\n              }\n              [data-critical-hero][data-hero-home] .hero-lead {\n                display: block;\n                margin-top: 6px;\n                font-size: 12px;\n                color: rgba(255, 255, 255, 0.82);\n              }\n              [data-critical-hero][data-hero-home] .hero-lead-mobile {\n                display: inline;\n              }\n              [data-critical-hero][data-hero-home] .hero-lead-desktop {\n                display: none;\n              }\n              [data-critical-hero][data-hero-home] .hero-badges {\n                display: none;\n              }\n              [data-critical-hero][data-hero-home] .hero-badge {\n                padding: 3px 8px;\n                font-size: 10px;\n 