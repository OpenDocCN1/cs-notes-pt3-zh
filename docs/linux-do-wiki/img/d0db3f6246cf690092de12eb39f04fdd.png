ional\":\"参考图（可选）\",\"referenceImageOptional\":\"参考图（可选）\",\"reference\":\"参考图\",\"uploading\":\"上传中\",\"uploadImage\":\"上传参考图\",\"referenceStrength\":\"参考强度\",\"prompt\":\"提示词\",\"model\":\"模型\",\"quality\":\"画质\",\"referencePreview\":\"参考图预览\",\"referenceImageAlt\":\"参考图\",\"upTo\":\"最多 {count} 张\",\"previous\":\"上一张\",\"next\":\"下一张\"},\"controls\":{\"textOnly\":\"仅文生图\",\"autoCompressed\":\"自动压缩\",\"auto\":\"自动\",\"advanced\":\"高级选项\",\"style\":\"风格\",\"color\":\"色彩\",\"lighting\":\"光照\",\"composition\":\"构图\",\"quality\":\"画质\",\"qualityLow\":\"低\",\"qualityMedium\":\"中\",\"qualityHigh\":\"高\",\"reference\":\"参考图\",\"optional\":\"可选\",\"new\":\"新\",\"googleDiscoveryTitle\":\"在这里切换不同模型\",\"googleDiscoveryDescription\":\"试试 GPT Image 2，以更低成本生成清晰效果。\"},\"styleCatalog\":{\"description\":\"选择一个风格预览。风格名称会与提示词分开发送。\",\"searchPlaceholder\":\"搜索风格\",\"close\":\"关闭\",\"clearSearch\":\"清除搜索\",\"loading\":\"正在加载风格…\",\"loadError\":\"风格加载失败。\",\"retry\":\"重试\",\"none\":\"无风格\",\"empty\":\"未找到相关风格。\"},\"referenceLimits\":{\"limitReached\":\"该模型最多支持 {limit} 张参考图\",\"trimmed\":\"已保留前 {limit} 张参考图，其余已移除\",\"partialAdd\":\"已添加 {added} 张参考图，超出的 {skipped} 张未加入\",\"basicUnsupported\":\"该模型暂不支持参考图，请切换到支持参考图的模型\",\"processing\":\"正在处理参考图\",\"restoreFailed\":\"部分参考图已失效，请删除后重新选择\"},\"resultItem\":{\"reason\":\"原因：{reason}\",\"details\":{\"style\":\"风格\",\"color\":\"色彩\",\"lighting\":\"光照\",\"composition\":\"构图\"},\"openReferenceImage\":\"放大查看参考图\",\"openReferenceImageNumber\":\"放大查看参考图 {number}\",\"regenerate\":\"重新生成\",\"create\":\"创建\",\"edit\":\"编辑\",\"watermarkFreeDownload\":\"无水印下载\",\"fastMode\":\"快速模式\",\"close\":\"关闭\",\"watermarked\":\"下载含水印\",\"downloadWithoutWatermark\":\"无品牌水印直出\",\"watermarkDownloadStarted\":\"带水印图片已开始下载。升级后可保存无水印高清原图。\",\"upgradePlan\":\"订阅会员套餐\",\"signInToUpgrade\":\"登录并升级\",\"referencePreviewAlt\":\"参考图预览\",\"previousImage\":\"上一张\",\"nextImage\":\"下一张\",\"previousReferenceImage\":\"上一张参考图\",\"nextReferenceImage\":\"下一张参考图\",\"expand\":\"扩图\",\"expandTitle\":\"把这张图送到扩图工具\",\"removeBg\":\"去背景\",\"removeBgTitle\":\"把这张图送到去背景工具\",\"upscale\":\"高清放大\",\"upscaleTitle\":\"把这张图送到 AI 图片高清放大工具\",\"background\":\"背景\",\"erase\":\"擦除\",\"effect\":\"效果\",\"openBackground\":\"给图片添加背景\",\"openErase\":\"擦除图片中不想要的部分\",\"openEffect\":\"调整模糊和阴影效果\",\"openFailed\":\"打开去背景编辑器失败\",\"loginWatermarkHint\":\"登录后可升级套餐，下载无品牌水印的高清图片。\",\"savedImageFailed\":\"生成后的图片保存失败\"},\"backgroundEditor\":{\"title\":\"结果编辑\",\"close\":\"关闭\",\"reset\":\"重置\",\"download\":\"下载\",\"backgroundTitle\":\"背景\",\"backgroundModalTitle\":\"添加背景\",\"photos\":\"照片\",\"colors\":\"颜色\",\"searchPlaceholder\":\"搜索\",\"searchPoweredBy\":\"搜索由...提供支持\",\"searchSupportedBy\":\"支持超过 3000 万张背景图\",\"eraseTitle\":\"擦除\",\"eraseModalTitle\":\"擦除背景\",\"brushSize\":\"画笔大小\",\"erase\":\"擦除\",\"restore\":\"恢复\",\"effectsTitle\":\"效果\",\"blurAmount\":\"背景模糊\",\"shadow\":\"阴影\",\"opacity\":\"透明度\"},\"canvas\":{\"promptPlaceholder\":\"输入你的提示词...\",\"generationFailed\":\"图像生成失败\",\"requiresPro\":\"Canvas AI 生成需要专业版订阅。\"},\"modelDescriptions\":{\"seedream4\":\"低成本 1K / 2K / 4K 生成与多参考图编辑。\",\"seedream5Pro\":\"专业级产品视觉、复杂文字与多参考图编辑。\",\"nanoBanana2Lite\":\"约 4 秒完成 1K 生成与编辑，适合高频迭代。\",\"raphaelBasic\":\"普通画质 · 慢速队列\",\"raphaelPro\":\"更高质量 · 快速队列\",\"gptImage15\":\"快速编辑与多参考图，适合稳定改图。\",\"gptImage2\":\"提示词更准，文字和产品图更清晰。\",\"seedream45\":\"2K / 4K 高清生成，适合参考图编辑。\",\"seedream5\":\"电影感写实，可结合联网搜索找参考。\",\"nanoBanana\":\"轻量 Gemini 图像编辑，适合快速改图。\",\"nanoBanana2\":\"多参考图改造，风格控制更快。\",\"nanoBananaPro\":\"4K 高清出图与高级图像编辑。\",\"gptImage25\":\"Flare：快速创作，参考图保真与自然细节。\",\"seedream5Flash\":\"低成本、快速生图与多参考图编辑。\"},\"failure\":{\"contentFlagged\":{\"title\":\"内容未通过安全检查\",\"body\":\"内容不符合生成规则，请调整提示词或更换参考图后重试。\"},\"nsfw\":{\"body\":\"内容可能包含成人或裸露相关描述，请调整提示词后重试。\"},\"protectedContent\":{\"body\":\"内容可能包含版权角色、品牌标志、商标或水印移除请求，请改成更通用的描述后重试。\"},\"violent\":{\"body\":\"内容可能包含暴力、血腥或不适合生成的描述，请调整提示词后重试。\"},\"badInputImage\":{\"title\":\"无法读取参考图\",\"body\":\"请使用有效的 JPG、PNG 或 WebP 图片后重试。\"},\"serverBusy\":{\"title\":\"服务器繁忙\",\"body\":\"当前生成服务繁忙，请稍后重试。\"},\"infraError\":{\"title\":\"服务暂时不可用\",\"body\":\"生成服务暂时不可用，请稍后重试。\"},\"upstreamQuota\":{\"title\":\"服务暂时不可用\",\"body\":\"当前供应商额度或限流导致生成失败，请稍后重试。\"},\"timeout\":{\"title\":\"生成超时\",\"body\":\"这次任务处理超时，请稍后重试。\"},\"outputSaveFailed\":{\"title\":\"图片保存失败\",\"body\":\"图片保存失败，请重试。\"},\"outputFetchFailed\":{\"title\":\"结果图获取失败\",\"body\":\"图片已完成处理，但暂时无法获取结果，请重试。\"},\"paramInvalid\":{\"title\":\"生成参数异常\",\"body\":\"当前参数组合暂不可用，请调整尺寸、清晰度或模型后重试。\"},\"taskLost\":{\"title\":\"任务异常中断\",\"body\":\"任务处理过程中异常中断，请重试。\"},\"unknown\":{\"title\":\"生成失败\",\"body\":\"生成失败，请稍后重试。\"},\"creditsRefunded\":\"已退还 {credits} 积分\",\"retry\":\"重试\",\"editPrompt\":\"修改提示词\",\"changeImage\":\"更换图片\",\"promptBlocked\":{\"body\":\"提示词未通过安全审核，请修改提示词后重试。\"},\"inputImageBlocked\":{\"body\":\"参考图未通过安全审核，请更换图片后重试。\"},\"outputImageBlocked\":{\"body\":\"生成结果未通过安全审核，请调整提示词或更换参考图后重试。\"},\"creditsRefundPending\":\"积分退款处理中\"},\"seedream5FlashPromoBanner\":{\"headline\":\"延续 Seedream 5.0 Pro 的创作能力，价格不到一半。\",\"limitedTime\":\"限时\",\"discountSuffix\":\"优惠\",\"cta\":\"试用\"}},\"sharePage\":{\"title\":\"Raphael 的 AI 图像\",\"description\":\"Raphael 的 AI 图像\",\"promptLabel\":\"提示词\",\"cta\":\"生成您自己的\",\"download\":\"下载\",\"edit\":\"编辑\"},\"newHero\":{\"features\":{\"free\":\"100% 免费\",\"noLogin\":\"无需登录\",\"poweredBy\":\"由 GPT Image 2.5 提供支持\",\"unlimited\":\"无限生成\",\"unlimitedShort\":\"无限\"},\"mainTitle\":\"Raphael AI\",\"h1Lead\":\"免费无限制 AI 图片生成器\",\"slogan\":\"全球首个无限免费 AI 图像生成器\",\"subTitle\":\"在几秒钟内创建令人惊叹的 AI 生成图像\",\"video\":{\"h1Lead\":\"免费 AI 视频生成器\",\"slogan\":\"MiniMax H3 Turbo 免费生成，免注册\",\"subTitle\":\"几分钟内将创意转化为精彩视频\",\"features\":{\"free\":\"免费生成视频\",\"quality\":\"Seedance 2.5\",\"noLogin\":\"免注册\"}}},\"pricing\":{\"amount\":\"$$10/月\",\"billing\":{\"billedAnnually\":\"按年计费\",\"billedMonthly\":\"按月计费\",\"monthly\":\"每月\",\"perMonth\":\"/月\",\"perYear\":\"/年\",\"savePercent\":\"节省 50%\",\"yearly\":\"每年\"},\"recommended\":\"推荐\",\"errors\":{\"processingFailed\":\"订阅处理失败。请稍后再试。\",\"subscriptionFailed\":\"订阅失败: {message}\",\"checkoutFailed\":\"结账失败\"},\"estimates\":{\"supportedModels\":\"支持所有积分模型（Seedream 3.5 Pro、Nano Banana、GPT Image、Seedream、Seedance、Kling、Veo）\",\"fastModeTooltip\":\"按 Seedream 3.5 快速模式 1 积分/张估算；不同模型和参数会有不同消耗。\"},\"faq\":{\"items\":{\"api\":{\"answer\":\"不，我们目前没有公共 API，但计划在不久的将来提供。我们很想了解您的具体要求。\",\"question\":\"我的订阅包含 API 访问权限吗？\"},\"commercial\":{\"answer\":\"是的。在遵守我们的使用条款和适用法律的前提下，付费订阅者可以将生成的图像用于个人或商业用途。除非 Raphael 另有明确说明，免费用户仅可将生成内容用于个人及其他非商业用途。您有责任确保您的提示词、上传内容和生成结果不侵犯第三方权利。\",\"question\":\"我必须是订阅者才能将图像用于商业用途吗？\"},\"enterprise\":{\"answer\":\"如果您有独特的用例并想了解更多定价信息，请发送邮件至 support@raphael.app 与我们联系。\",\"question\":\"企业版是用于什么的？\"},\"imageQuality\":{\"answer\":\"是的！专业版和旗舰版包含可用于 Seedream 3.5 Pro 和其他积分模型的每月积分。Seedream 3.5 Pro 可生成细节更丰富的图像，旗舰版在高峰时段享有最高队列优先级。\",\"question\":\"如果我订阅，我能获得更高质量的图像吗？\"},\"priceIncrease\":{\"answer\":\"很可能……虽然我们努力保持我们的套餐价格实惠，但我们也会增加更多功能并构建更强大的模型，这会带来更高的成本。但是，如果您购买年度套餐，我们将很乐意遵守。\",\"question\":\"你们会涨价吗？\"},\"refund\":{\"answer\":\"一般情况下，数字产品和虚拟产品购买不支持退款。如果您有退款申请或账单问题，请发送邮件至 support@raphael.app，我们通常会在 3 个工作日内回复。\",\"question\":\"我可以退款吗？\"},\"support\":{\"answer\":\"是的！如需任何帮助，您可以通过 support@raphael.app 电子邮件联系我们。\",\"question\":\"我能获得使用产品的帮助吗？\"},\"trafficLimit\":{\"answer\":\"在正常使用情况下，您不会看到此消息。但是，如果我们的系统检测到异常使用模式（例如逆向工程尝试或其他未经授权的方法），您仍然可能会看到此消息。\",\"question\":\"如果我订阅了，还会收到“流量过多”的消息吗？\"},\"upgradeCancel\":{\"answer\":\"暂不支持直接切换套餐。您可以随时在订阅管理门户取消续费，当前权益会保留到本计费周期结束。到期后，您可以重新选择其他套餐。\",\"question\":\"我可以切换套餐或取消订阅吗？\"},\"whySubscribe\":{\"answer\":\"您的支持帮助我们保持网站免费，并带来一些宝贵的福利！\\n\\n• 您的图像将没有水印！\\n• 速度更快，您将获得比其他用户更高的优先级。当有图像生成队列时，我们会将您移到最前面，这在流量高峰期尤其有用！\\n• 您的图像是完全私密的，不会在我们的公共图库或推荐图像中共享。\\n• 您不会有任何广告！\",\"question\":\"为什么要订阅？\"}},\"subtitle\":\"获取常见问题的答案，了解我们的订阅套餐\",\"title\":\"常见问题\"},\"features\":{\"advancedRefine\":{\"title\":\"高级精炼功能\",\"tooltip\":\"增强的图像精炼，质量更高，速度更快\"},\"basicRefine\":\"基础精炼功能\",\"earlyAccess\":{\"title\":\"抢先体验新功能\",\"tooltip\":\"在新功能公开发布之前率先试用\"},\"slowSpeed\":{\"title\":\"标准速度\",\"tooltip\":\"免费慢速队列会先等待 50 秒，整体通常约 60 秒起。高负载时可能更久。\"},\"fastSpeed\":{\"title\":\"快速生成 (2倍)\",\"tooltip\":\"每张图像生成约需 10 秒\"},\"fastestSpeed\":{\"title\":\"🔥 最快生成 (5倍)\",\"tooltip\":\"每张图像生成约需 4 秒 - 可用的最快速度。保证在排队图像生成时享有最高优先级，即使在高负载期间也是如此。\"},\"fastModeGenerations\":{\"monthly\":\"每月约 {amount} 次快速模式图像生成\"},\"unlimitedBasic\":{\"title\":\"无限 Seedream 3.5 生成\",\"tooltip\":\"使用 Seedream 3.5 生成无限图像。无需积分。\"},\"priorityQueue\":{\"title\":\"优先队列\",\"tooltip\":\"在使用普通模式 (快速模式关闭) 时，在生成队列中获得更高优先级\"},\"highestPriority\":{\"title\":\"最高优先级队列\",\"tooltip\":\"在生成队列中享有最高优先级。即使在重负载下，您的生成也会优先开始。\"},\"fullPrivacy\":{\"title\":\"完全隐私\",\"tooltip\":\"最大隐私保护：您的生成图像不会在公共图库中公开显示或用于模型训练\"},\"hdImages\":{\"title\":\"Seedream 3.5 Pro 访问权限\",\"tooltip\":\"使用 Seedream 3.5 Pro 生成画质更高、细节更丰富的图像。Pro 生成消耗积分。\"},\"noAds\":\"无广告\",\"noHdImages\":\"仅限 Seedream 3.5 免费模型\",\"noWatermarks\":\"无水印\",\"privateGen\":{\"title\":\"私密生成\",\"tooltip\":\"您生成的图像不会在社区图库中公开显示\"},\"refineSpeed\":{\"title\":\"2倍精炼速度\",\"tooltip\":\"处理精炼的速度是专业版套餐的两倍\"},\"unlimited\":\"无限图像生成\",\"aiPhotoEditorSlow\":{\"title\":\"AI 照片编辑器 (等待 45 秒)\",\"tooltip\":\"使用文本命令通过 AI 编辑照片。免费用户在队列中等待 45 秒。\"},\"aiPhotoEditorFast\":{\"title\":\"快速 AI 照片编辑器\",\"tooltip\":\"使用文本命令通过 AI 编辑照片。更快处理，无水印。\"},\"aiPhotoEditorInstant\":{\"title\":\"即时 AI 照片编辑器\",\"tooltip\":\"使用 AI 即时编辑照片，无需等待。优质结果，无水印。\"},\"credits\":{\"monthly\":\"每月 {amount} 积分\"},\"accessProModel\":{\"title\":\"解锁 Seedream 3.5 Pro\",\"tooltip\":\"支持 1K 和 1.5K 分辨率，生成更清晰的细节。适合日常专业用途。\"},\"accessMaxUltraModels\":{\"title\":\"解锁 Max (1.5K) 和 Ultra (2K)\",\"tooltip\":\"独家访问我们的旗舰大型模型。生成最先进的艺术杰作和 4MP 照片写实图像。\"},\"videoGeneration\":{\"title\":\"每月约 {amount} 条基础视频\",\"tooltip\":\"按 {model} {resolution}、{duration} 秒、单个视频 {credits} 积分估算；其他视频模型、分辨率和时长会消耗更多积分。\"},\"noVideoGeneration\":{\"title\":\"视频生成 (积分不足)\",\"tooltip\":\"视频生成需要更多积分。升级到专业版或旗舰版以获得视频访问权限。\"}},\"manage\":{\"button\":\"管理订阅\"},\"manageSubscription\":\"管理订阅\",\"per_month\":\"/month\",\"per_year\":\"/year\",\"plans\":{\"enterprise\":{\"button\":\"即将推出\",\"features\":{\"apiAccess\":\"API 访问\",\"customIntegrations\":\"自定义集成\",\"customModels\":\"自定义模型\",\"dedicatedSupport\":\"专属支持\",\"highVolume\":\"高用量\"},\"price\":\"定制\"},\"free\":{\"name\":\"免费\"},\"premium\":{\"badge\":\"最受欢迎\",\"button\":\"升级到专业版\",\"description\":\"最适合专业用途\",\"name\":\"专业版\"},\"pro\":{\"badge\":\"最受欢迎\",\"button\":\"升级到专业版\",\"description\":\"最适合专业用途\",\"name\":\"专业版\"},\"ultimate\":{\"button\":\"升级到旗舰版\",\"description\":\"面向重度用户\",\"name\":\"旗舰版\",\"badge\":\"最具价值\"},\"max\":{\"button\":\"升级到至尊版\",\"description\":\"适合超高用量创作者\",\"name\":\"至尊版\"}},\"prefix\":\"升级到专业版仅需\",\"pricing\":{\"amount\":\"$$10/month\",\"per_month\":\"/month\",\"per_year\":\"/year\",\"prefix\":\"升级到专业版仅需\",\"suffix\":\"(按年计费)\"},\"processing\":\"正在处理您的订阅...\",\"subtitle\":\"免费图像包含水印。升级以获得干净的输出、更快的生成和商业用途。\",\"success\":{\"common\":{\"featuresReady\":\"您的专业版功能已准备就绪！\",\"processing\":\"正在处理您的订阅...\",\"startCreating\":\"开始创作\"},\"pro\":{\"subtitle\":\"感谢您订阅我们的专业版套餐。您的支持对我们意义重大！\",\"title\":\"欢迎加入专业版！\"},\"ultimate\":{\"subtitle\":\"感谢您加入我们的旗舰版套餐。您现在是我们最高级别的一员了！\",\"title\":\"欢迎加入旗舰版！\"},\"max\":{\"subtitle\":\"感谢您加入我们的至尊版套餐。您现在是我们最高级别的一员了！\",\"title\":\"欢迎加入至尊版！\"}},\"suffix\":\"(按年计费)\",\"title\":\"选择您的套餐\",\"upgrade\":{\"button\":\"立即升级\",\"features\":{\"noWatermark\":{\"description\":\"所有生成的图像均可用于商业用途\",\"title\":\"无水印\"},\"priority\":{\"description\":\"在高峰时段跳过等待队列\",\"title\":\"优先队列\"},\"private\":{\"description\":\"您生成的图像不会在社区图库中公开显示\",\"title\":\"私密生成\"},\"speed\":{\"description\":\"跳过约 60 秒的免费慢速队列\",\"title\":\"5倍更快的生成速度\"}},\"pricing\":{\"amount\":\"$$10/month\",\"per_month\":\"/month\",\"per_year\":\"/year\",\"prefix\":\"升级到专业版仅需\",\"suffix\":\"(按年计费)\"},\"title\":\"专业版福利\"},\"checkout\":{\"preparing\":\"正在准备支付页面...\"},\"payment\":{\"cnPayLabel\":\"人民币支付\"},\"creditPacks\":{\"tab\":\"积分包\",\"headline\":\"订阅用户同价额外获得 \u003cvalue\u003e+50%\u003c/value\u003e 积分\",\"creditsAmount\":\"{amount} 积分\",\"subscriberValue\":\"订阅用户可获得：{amount}\",\"baseValue\":\"基础积分：{amount}\",\"bonusValue\":\"订阅赠送：{amount}\",\"oneTime\":\"一次性购买\",\"validFor\":\"6 个月有效\",\"buyNow\":\"购买积分包\",\"buySelected\":\"购买所选积分包\",\"memberBenefitsNote\":\"积分包同享会员高级权益，不含无限生成。\",\"loading\":\"正在加载积分包...\",\"unavailable\":\"当前环境暂未开放积分包。\",\"recommended\":\"推荐\",\"processing\":\"处理中...\"},\"unlimitedModels\":{\"title\":\"支持的无限模型\",\"label\":\"无限\",\"details\":\"查看 {model} 的无限权益\",\"basic\":\"解锁 0.5K（Low）无限图片生成，高峰期需排队。\",\"image\":\"解锁 1K / 1.5K（Low）无限图片生成，高峰期需排队。\",\"video\":\"解锁 480P（4–8 秒）/ 768P（4–6 秒）无限视频生成，高峰期需排队。\",\"usage\":{\"learnMore\":\"了解详情\",\"close\":\"关闭\",\"title\":\"无限生成使用说明\",\"summary\":\"无限模式不扣积分，限套餐支持的模型与规格。受公平使用规则约束，近期使用量较高或服务繁忙时，等待时间可能延长。\",\"intro\":\"在包含无限生成权益的会员套餐有效期内，你可以使用指定模型和规格持续创作，无需消耗积分。具体适用范围以套餐及模型旁的权益说明为准。\",\"scope\":{\"title\":\"1. 无限生成包含什么？\",\"body\":\"在支持的模型和规格下，选择无限模式生成不会扣除积分，权益有效期内不设固定的累计生成次数上限。其他模型、更高规格或积分模式仍按页面显示消耗积分。\"},\"period\":{\"title\":\"2. 权益有效期\",\"body\":\"会员无限权益仅在包含该权益的套餐有效期内可用。会员到期或降级生效后，不再享有原套餐对应的无限权益。面向所有用户开放的基础免费生成，按其独立规则提供。\"},\"speed\":{\"title\":\"3. 生成速度与等待时间\",\"body\":\"为保障所有用户的使用体验，无限模式的排队时间和处理速度可能根据使用情况及服务负载动态调整。无限生成不承诺固定处理速度或完成时间。\"},\"parallel\":{\"title\":\"4. 同时生成限制\",\"body\":\"无限模式仍受同时进行的任务数量及提交间隔限制，具体以生成页面提示为准。如需使用积分模式，请在提交前查看对应积分消耗。\"},\"fairUse\":{\"title\":\"5. 公平使用\",\"body\":\"请通过正常页面操作使用无限生成权益。禁止使用自动化脚本批量调用、绕过使用限制、共享或出租账号，以及转售平台生成服务访问权限。对于经核实的滥用行为，Raphael 可限制或暂停相关权益；严重或重复违规的，可终止账号访问。\"}},\"comparisonTitle\":\"无限模型权益\",\"notIncluded\":\"不含无限\",\"notIncludedDescription\":\"该套餐不含此模型的无限权益，仍可使用积分生成。\"}},\"quickI2I\":{\"modal\":{\"cancel\":\"取消\",\"tabs\":{\"image\":\"图像\",\"video\":\"视频\"},\"changePhoto\":\"选择一张新照片\",\"chooseNewPhoto\":\"选择一张新照片\",\"clear\":\"清除\",\"generate\":\"生成\",\"idleDescription\":\"上传照片以开始风格化\",\"previewAlt\":\"预览\",\"processing\":\"处理中...\",\"readyDescription\":\"准备就绪！点击下方按钮。\",\"recentAlt\":\"最近的图像\",\"recentlyUsed\":\"最近使用\"},\"nav\":{\"next\":\"下一张\",\"previous\":\"上一张\"},\"sections\":{\"discoveryTitle\":\"发现新内容\",\"stylesTitle\":\"尝试一种风格\",\"templatesTitle\":\"图片模板\"},\"templates\":{\"sketch\":{\"title\":\"AI 素描肖像生成器\"},\"holiday-portrait\":{\"title\":\"AI 节日肖像生成器\"},\"dramatic\":{\"title\":\"AI 黑白戏剧肖像\"},\"plushie\":{\"title\":\"AI 毛绒玩偶生成器\"},\"baseball-bobblehead\":{\"title\":\"AI 棒球摇头公仔生成器\"},\"3d-glam-doll\":{\"title\":\"AI 3D 时尚娃娃生成器\"},\"doodle\":{\"title\":\"AI 涂鸦肖像生成器\"},\"inkwork\":{\"title\":\"AI 墨线插画生成器\"},\"fisheye\":{\"title\":\"AI 鱼眼肖像生成器\"},\"pop-art\":{\"title\":\"AI 波普艺术肖像生成器\"},\"ornament\":{\"title\":\"AI 圣诞挂饰照片生成器\"},\"sugar-cookie\":{\"title\":\"AI 糖霜饼干艺术生成器\"},\"art-school\":{\"title\":\"AI 文艺学院风肖像生成器\"},\"create-a-holiday-card\":{\"title\":\"AI 节日贺卡生成器\"},\"k-pop-star\":{\"title\":\"AI 韩流偶像写真生成器\"},\"girl-with-a-pearl\":{\"title\":\"AI 珍珠耳环少女肖像\"},\"create-an-album-cover\":{\"title\":\"AI 专辑封面生成器\"},\"style-me\":{\"title\":\"AI 穿搭生成器\"},\"create-a-professional-product-photo\":{\"title\":\"AI 产品图生成器\"},\"redecorate-my-room\":{\"title\":\"AI 房间改造生成器\"},\"give-us-a-matching-outfit\":{\"title\":\"AI 同款穿搭生成器\"},\"create-a-professional-job-photo\":{\"title\":\"AI 职业形象照生成器\"},\"remove-people-in-the-background\":{\"title\":\"AI 背景路人移除\"},\"restore-an-old-photo\":{\"title\":\"AI 老照片修复\"},\"turn-into-a-keychain\":{\"title\":\"AI 钥匙扣生成器\"}},\"toast\":{\"failedToClearRecents\":\"清除最近记录失败\",\"failedToProcessImage\":\"处理图像失败\",\"invalidImageFile\":\"无效的图像文件\",\"recentsCleared\":\"最近记录已清除\",\"storageFull\":\"存储已满\"}},\"settings\":{\"history\":{\"empty\":\"暂无历史记录。\",\"loadMore\":\"加载更多\",\"retry\":\"重试\",\"loading\":\"加载中...\",\"partial\":\"部分\",\"partialHint\":\"部分图像是使用临时链接保存的。\",\"cancel\":\"取消\",\"generationFailed\":\"生成失败\",\"unknownError\":\"生成过程中发生未知错误。\",\"errorProtectedContent\":\"受保护的内容——提示词或图像可能包含角色、徽标、商标或移除水印的请求。\",\"errorImageProcessing\":\"图像处理失败——请检查格式 (JPG/PNG/WebP)、大小 (\u003c10 MB) 和 URL 可访问性。\",\"errorServerBusy\":\"服务器当前繁忙。请稍后再试。\",\"errorNsfw\":\"检测到 NSFW 内容。\",\"tabs\":{\"image\":\"图像\",\"video\":\"视频\"}},\"plan\":{\"currentFeatures\":\"当前功能\",\"currentPlan\":\"当前套餐\",\"paused\":\"已暂停\",\"paymentPausedDescription\":\"付款失败，会员权益已暂停。更新付款后会自动恢复。\",\"expiryDate\":\"到期日期: {date}\",\"manage\":{\"button\":\"管理套餐\"},\"title\":\"套餐与账单\",\"ultimate\":{\"title\":\"升级到旗舰版\",\"description\":\"获得最高优先级队列、完全隐私保护以及新功能的抢先体验。\",\"button\":\"查看旗舰版套餐\",\"features\":{\"hdImages\":\"最高优先级队列\",\"refineSpeed\":\"完全隐私保护\",\"priority\":\"抢先体验新功能\"}},\"ultimateCallout\":{\"title\":\"解锁 Seedream 3.5 Pro\",\"description\":\"生成画质更高、细节更丰富的图像。Seedream 3.5 Pro 生成消耗积分。\",\"button\":\"查看套餐\"},\"upgrade\":{\"button\":\"立即升级\",\"features\":{\"credits\":{\"description\":\"每月获得 2,000 积分，而不是每天仅 10 积分\",\"title\":\"200 倍更多积分\"},\"noWatermark\":{\"description\":\"所有生成的图像均可用于商业用途\",\"title\":\"无水印\"},\"priority\":{\"description\":\"在高峰时段跳过等待队列\",\"title\":\"优先队列\"},\"private\":{\"description\":\"您生成的图像不会在社区图库中公开显示\",\"title\":\"私密生成\"},\"speed\":{\"description\":\"跳过约 60 秒的免费慢速队列\",\"title\":\"5倍更快的生成速度\"}},\"credits\":{\"current\":\"当前积分\",\"hint\":\"升级到专业版，每月获得 {monthly} 积分，而不是每天 {daily} 积分\"},\"pricing\":{\"amount\":\"$$20/month\",\"per_month\":\"/month\",\"per_year\":\"/year\",\"prefix\":\"升级到专业版仅需\",\"suffix\":\"(按年计费)\"},\"title\":\"专业版福利\"},\"upgradeBadge\":\"可升级\",\"cancelScheduled\":\"已取消，到期前可用\"},\"profile\":{\"email\":\"电子邮件\",\"name\":\"姓名\",\"title\":\"个人资料信息\",\"credits\":\"积分信息\",\"currentCredits\":\"当前积分\",\"planQuota\":\"月度配额\",\"perMonth\":\"每月\",\"nextReset\":\"下次重置\"},\"title\":\"设置\",\"assets\":{\"title\":\"资产库\",\"subtitle\":\"资产可以保留 30 天，请及时下载。\",\"image\":\"图片\",\"video\":\"视频\",\"search\":\"搜索提示词\",\"loading\":\"加载中...\",\"loadMore\":\"加载更多\",\"empty\":\"暂无资产。\",\"retry\":\"重试\",\"downloadFailed\":\"下载失败\",\"today\":\"今天\",\"yesterday\":\"昨天\",\"featureImage\":\"图片\",\"featureBackgroundRemover\":\"去背景\",\"featureImageExtend\":\"扩图\",\"featureImageEdit\":\"图片编辑\",\"featureImageToImage\":\"图生图\",\"deleteAction\":\"删除\",\"deleteTitle\":\"删除这个资产？\",\"deleteDescription\":\"这个资产及关联的生成历史将从你的账号中移除。删除后无法恢复。\",\"deleteCancel\":\"取消\",\"deleteConfirm\":\"删除\",\"deleteSuccess\":\"已删除。\",\"deleteFailed\