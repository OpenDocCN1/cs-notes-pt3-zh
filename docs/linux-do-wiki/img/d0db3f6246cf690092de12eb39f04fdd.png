              @font-face {
                font-family: "Raphael Inter Supplemental";
                src: url("/fonts/inter-latin-supplement-wght-normal.woff2") format("woff2-variations");
                font-style: normal;
                font-display: swap;
                font-weight: 100 900;
                unicode-range: U+00A0-00FF, U+0131, U+0152-0153, U+02BB-02BC,
                  U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329,
                  U+2000-206F, U+20AC, U+2122, U+2191, U+2193,
                  U+2212, U+2215, U+FEFF, U+FFFD;
              }
              @font-face {
                font-family: "Raphael Inter Fallback";
                src: local("Arial");
                ascent-override: 89.79%;
                descent-override: 22.36%;
                line-gap-override: 0%;
                size-adjust: 107.89%;
              }
              :root {
                color-scheme: dark;
                --background: 28 25% 10%;
                --foreground: 48 30% 90%;
                --primary: 28 52% 58%;
                --primary-foreground: 42 20% 96%;
                --border: 28 20% 15%;
              }
              body {
                background-color: hsl(var(--background));
                color: hsl(var(--foreground));
                margin: 0;
                min-height: 100vh;
                font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
                text-rendering: optimizeLegibility;
              }
              .container {
                width: 100%;
                max-width: 1200px;
                margin-left: auto;
                margin-right: auto;
                padding-left: 1rem;
                padding-right: 1rem;
              }
              [data-critical-header] {
                position: relative;
                z-index: 260;
              }
              @media (min-width: 1024px) {
                [data-critical-header] nav {
                  display: flex;
                  align-items: center;
                  justify-content: space-between;
                  gap: 1rem;
                }
              }
              [data-critical-hero] {
                padding: 32px 0 16px;
                text-align: center;
              }
              @media (min-width: 640px) {
                [data-critical-hero] {
                  padding: 64px 0 32px;
                }
              }
              [data-critical-hero] h1 {
                margin: 0;
                font-weight: 700;
                font-size: 28px;
                line-height: 1.15;
              }
              @media (min-width: 640px) {
                [data-critical-hero] h1 {
                  font-size: 40px;
                }
              }
              @media (min-width: 1024px) {
                [data-critical-hero] .hero-lead {
                  display: block;
                  margin-top: 12px;
                  font-size: 18px;
                  color: rgba(255, 255, 255, 0.82);
                }
                [data-critical-hero] .hero-badges {
                  display: flex;
                  flex-wrap: wrap;
                  gap: 8px;
                  justify-content: center;
                  margin-top: 24px;
                  min-height: 28px;
                }
              }
              [data-critical-hero] .hero-badge {
                display: inline-flex;
                align-items: center;
                padding: 6px 10px;
                border-radius: 9999px;
                font-size: 12px;
                font-weight: 600;
                color: #f59e0b;
                background: rgba(245, 158, 11, 0.1);
                border: 1px solid rgba(245, 158, 11, 0.2);
              }
              /* Home hero keeps one compact benefit line on mobile and restores
                 the full subtitle + badges from the tablet breakpoint. */
              [data-critical-hero][data-hero-home] {
                padding: 16px 0 12px;
              }
              [data-critical-hero][data-hero-home] .hero-lead {
                display: block;
                margin-top: 6px;
                font-size: 12px;
                color: rgba(255, 255, 255, 0.82);
              }
              [data-critical-hero][data-hero-home] .hero-lead-mobile {
                display: inline;
              }
              [data-critical-hero][data-hero-home] .hero-lead-desktop {
                display: none;
              }
              [data-critical-hero][data-hero-home] .hero-badges {
                display: none;
              }
              [data-critical-hero][data-hero-home] .hero-badge {
                padding: 3px 8px;
                font-size: 10px;
              }
              @media (min-width: 640px) {
                [data-critical-hero][data-hero-home] {
                  padding: 24px 0 18px;
                }
                [data-critical-hero][data-hero-home] .hero-lead {
                  margin-top: 6px;
                  font-size: 16px;
                }
                [data-critical-hero][data-hero-home] .hero-lead-mobile {
                  display: none;
                }
                [data-critical-hero][data-hero-home] .hero-lead-desktop {
                  display: inline;
                }
                [data-critical-hero][data-hero-home] .hero-badges {
                  display: flex;
                  flex-wrap: wrap;
                  gap: 6px;
                  justify-content: center;
                  margin-top: 10px;
                  min-height: 24px;
                }
              }
              @media (min-width: 1024px) {
                [data-critical-hero][data-hero-home] {
                  padding: 20px 0 16px;
                }
                [data-critical-hero][data-hero-home] .hero-lead {
                  margin-top: 8px;
                  font-size: 16px;
                }
                [data-critical-hero][data-hero-home] .hero-badges {
                  gap: 6px;
                  margin-top: 10px;
                }
                [data-critical-hero][data-hero-home] .hero-badge {
                  padding: 4px 10px;
                  font-size: 11px;
                }
              }
